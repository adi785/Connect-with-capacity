# CAPACITY CONNECT — backend configuration.
#
# Copy to `.env` in this directory (the repository root, which is where you must run
# uvicorn from — pydantic-settings resolves `.env` relative to the process CWD).

# ============================ APPLICATION ============================
ENV=development
# Production startup rejects this placeholder; set a unique random value in deployment.
SECRET_KEY=dev-insecure-change-me
# Add the exact deployed frontend origin here. Keep localhost entries for local dev.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional fallback for Vercel-hosted frontends. Prefer an exact CORS_ORIGINS entry.
# CORS_ORIGIN_REGEX=https://<your-frontend-project>\\.vercel\\.app

# ============================= DATABASE ==============================
# Supabase → Project Settings → Database → Connection string → URI.
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Optional: dedicated test database URL. If left blank, pytest uses an isolated local async SQLite database.
# Automated tests will strictly refuse to connect to a live Supabase or production instance.
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/test_db

DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# ====================== SUPABASE AUTHENTICATION ======================
# AUTH_MODE:
#   auto      (default) → supabase when credentials are present, else dev
#   supabase           → verify real JWTs via Supabase JWKS / Auth API
#   dev                → accept unsigned, self-describing tokens for local tests
AUTH_MODE=auto

# Cold-start bootstrap. These emails are promoted to an approved admin on first
# sign-in — without at least one, no account exists that can approve anybody else.
BOOTSTRAP_ADMIN_EMAILS=admin@capacityconnect.com

# ======================== SUPABASE (STORAGE & AUTH) ==================
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=

# Buckets in Supabase dashboard
BUCKET_LECTURE_RESOURCES=lecture-resources
BUCKET_CERTIFICATES=certificates
BUCKET_PROFILE_PHOTOS=profile-photos
SIGNED_URL_TTL_SECONDS=3600

# ============================= UPLOADS ===============================
MAX_UPLOAD_MB_VIDEO=500
MAX_UPLOAD_MB_DOCUMENT=50
MAX_UPLOAD_MB_IMAGE=5

# ========================== RATE LIMITING ============================
REDIS_URL=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_SENSITIVE=10/minute

# ============================== EMAIL ================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
